# Bu dosyayı ".env.local" adıyla kopyalayın ve değerleri doldurun. (Kurulum: README.md)
# Vercel'de aynı değişkenleri Project Settings > Environment Variables bölümüne girin.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uygulamanın adresi. Google Console'daki "Authorized redirect URI" = APP_URL + /api/google/callback
#   Yerel:  http://localhost:3000        Yayında: https://<proje>.vercel.app
APP_URL=http://localhost:3000

# Veritabanı. Boş bırakılırsa bilgisayarda yerel PostgreSQL (PGlite) kullanılır: data/pglite
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
#   postgresql://postgres.<proje>:<şifre>@aws-0-<bölge>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# İsteğe bağlı: tanımlanırsa uygulama açılışta bu şifreyi sorar (internete açarken önerilir).
APP_PASSWORD=

# Saat dilimi (planlama ve günlük hesaplar için)
APP_TIMEZONE=Europe/Istanbul

# İsteğe bağlı: Vercel Cron isteğini doğrulamak için rastgele bir değer
CRON_SECRET=
